{
  "name": "betastreams",
  "version": "0.1.0",
  "private": true,
  "description": "Sports EPG to event matching Stremio add-on",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:assets",
    "copy:assets": "mkdir -p dist/shared/db/migrations && cp src/shared/db/migrations/*.sql dist/shared/db/migrations/",
    "dev:server": "tsx watch src/entrypoint.ts",
    "start": "node dist/entrypoint.js",
    "migrate": "node dist/shared/db/migrate.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:web": "npm --prefix web run build",
    "verify:espn-paths": "tsx scripts/verifyEspnPaths.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.4",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "js-yaml": "^5.4.2",
    "pino": "^9.6.0",
    "saxes": "^6.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.7",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
