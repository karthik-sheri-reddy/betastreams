# Copy to .env for local dev, or set these in Coolify's Environment
# Variables tab for deployment. Never commit a real .env file.

# ---- Core ----
NODE_ENV=production
PORT=7000
DATA_DIR=/data
# Full public HTTPS URL the add-on is reachable at. Used to build manifest,
# poster, and play URLs, and must match what Stremio/browsers hit.
PUBLIC_BASE_URL=https://REPLACE_ME.duckdns.org
LOG_LEVEL=info
# Default IANA timezone used until a user's config overrides it.
TZ_DEFAULT=America/New_York

# ---- Security ----
# Required for /admin to start. Generate with: openssl rand -hex 32
ADMIN_TOKEN=
# HMAC key for signed /play tokens. Generate with: openssl rand -hex 32
SIGNING_SECRET=

# ---- Playback ----
# "redirect" (default, 302 to upstream) or "hls" (proxy + rewrite segment
# URLs; see README for the bandwidth trade-off).
PROXY_MODE=redirect

# ---- Feature flags ----
ENABLE_OCR=false
ENABLE_506=false

# ---- Operator sources (never commit real values) ----
# Comma-separated M3U playlist URLs.
M3U_URLS=
# Comma-separated XMLTV EPG URLs, paired positionally with M3U_URLS where
# applicable.
EPG_URLS=
# JSON array of Xtream Codes accounts. Example:
# [{"id":"acct1","server_url":"http://example.com:8080","username":"user","password":"pass","output":"m3u8"}]
XTREAM_ACCOUNTS=

# ---- Optional: Schedules Direct (cleaner EPG) ----
SCHEDULES_DIRECT_USERNAME=
SCHEDULES_DIRECT_PASSWORD=

# ---- Worker ----
WORKER_RESTART_MAX_BACKOFF_MS=30000
